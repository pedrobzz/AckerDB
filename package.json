{
  "name": "ackerdb",
  "description": "AckerDB - The All-in-One Back-End Framework",
  "private": true,
  "license": "FSL-1.1-ALv2",
  "workspaces": [
    "packages/*",
    "packages/realtime-native/*",
    "fixtures/*"
  ],
  "scripts": {
    "test": "bun test ./packages/core/test ./packages/server/test ./packages/realtime/test ./packages/client/test ./packages/cli/test && bun test ./packages/client-react/test && bun test ./bench && bun scripts/mcp-conformance.ts && bun scripts/verify-packages.ts",
    "test:mcp:conformance": "bun scripts/mcp-conformance.ts",
    "test:mcp:hosts": "bun scripts/mcp-host-acceptance.ts",
    "test:packages": "bun scripts/verify-packages.ts",
    "test:packages:webrtc": "bun scripts/verify-packages.ts --require-webrtc",
    "typecheck": "bunx tsc -p tsconfig.json --noEmit && bunx tsc -p packages/client-react/tsconfig.json --noEmit && bunx tsc -p fixtures/expo-app/tsconfig.json --noEmit",
    "typecheck:bench": "bun packages/cli/src/commands/main.ts codegen bench/ackerdb-app && bunx tsc -p bench/tsconfig.json --noEmit",
    "typecheck:tooling": "bunx tsc -p scripts/tsconfig.json --noEmit",
    "diagnostic:validator": "bun scripts/validator-diagnostic.ts",
    "build:webrtc": "bun packages/realtime/native/webrtc/build.ts",
    "assemble:webrtc": "bun packages/realtime/native/webrtc/package.ts",
    "pack:webrtc-candidate": "bun packages/realtime/native/webrtc/candidate.ts pack",
    "verify:webrtc-candidate": "bun packages/realtime/native/webrtc/candidate.ts verify",
    "audit:prod": "bun scripts/ci/audit-production.ts",
    "test:webrtc": "bun run build:webrtc && bun test ./packages/realtime/native/webrtc/test",
    "registry": "bunx verdaccio --config registry/config.yaml",
    "release:prepare": "bun scripts/release/prepare.ts",
    "publish:beta": "bun scripts/release/publish.ts beta",
    "publish:beta:demo": "bun scripts/release/publish.ts beta --demo",
    "publish:npm": "bun scripts/release/publish.ts npm",
    "prepare": "git config core.hooksPath .githooks && git config branch.main.mergeoptions --no-ff && git config branch.canary.mergeoptions --no-ff"
  },
  "devDependencies": {
    "@modelcontextprotocol/conformance": "0.1.16",
    "@napi-rs/cli": "3.8.2",
    "@types/bun": "^1.2.0",
    "@types/node": "22.15.3",
    "ackerdb-test-support": "workspace:*",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "@hono/node-server": "2.0.12",
    "brace-expansion": "5.0.9",
    "fast-uri": "3.1.5",
    "uuid": "11.1.1",
    "hono": "4.12.34",
    "ip-address": "10.4.0",
    "postcss": "8.5.25"
  }
}

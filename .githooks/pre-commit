#!/bin/sh
# Local reminder only; GitHub branch protection is authoritative.

branch=$(git symbolic-ref --short -q HEAD)
if [ "$branch" = "main" ] || [ "$branch" = "canary" ]; then
  echo "✖ direct commits to $branch are blocked — create a topic branch:" >&2
  echo "    git checkout -b feat/<name>" >&2
  exit 1
fi

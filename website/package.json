{
  "name": "@ackerdb/website",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "build:publication": "bun run scripts/publication/build.ts",
    "preview": "bun run scripts/serve-static.ts .output/public 4173",
    "typecheck": "tsc --noEmit",
    "test:static": "bun test test/documentation/*.test.ts test/publication/*.test.ts",
    "test:publication-builds": "bun run scripts/publication/verify-builds.ts",
    "test:e2e": "playwright test",
    "verify": "bun run typecheck && bun run build && bun run test:static && bun run test:e2e && bun run test:publication-builds"
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@tanstack/react-router": "1.170.18",
    "@tanstack/react-start": "1.168.28",
    "@tanstack/start-static-server-functions": "1.167.19",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "fumadocs-core": "16.14.0",
    "fumadocs-mdx": "15.2.1",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.14.0",
    "lucide-react": "0.545.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "1.2.13",
    "@types/mdx": "2.0.13",
    "@types/node": "24.1.0",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@vitejs/plugin-react": "6.0.3",
    "nitro": "3.0.260610-beta",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.2",
    "vite": "8.1.5"
  }
}

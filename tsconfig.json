{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext"],
    "types": ["bun"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@ackerdb/core": ["./packages/core/src/index.ts"],
      "@ackerdb/server": ["./packages/server/src/index.ts"],
      "@ackerdb/server/mcp": ["./packages/server/src/mcp/index.ts"],
      "@ackerdb/cache": ["./packages/cache/src/index.ts"],
      "@ackerdb/cache/redis": ["./packages/cache/src/adapters/redis.ts"],
      "@ackerdb/cache/upstash": ["./packages/cache/src/adapters/upstash.ts"],
      "@ackerdb/client": ["./packages/client/src/index.ts"],
      "@ackerdb/client-react": ["./packages/client-react/src/index.ts"]
    }
  },
  "include": ["packages/*/src/**/*.ts", "packages/*/test/**/*.ts"],
  "exclude": ["packages/client-react"]
}

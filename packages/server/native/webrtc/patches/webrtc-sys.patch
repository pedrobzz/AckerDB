+std::shared_ptr<MediaStreamTrack>
+PeerConnectionFactory::clone_media_stream_track(
+    rust::String label,
+    std::shared_ptr<MediaStreamTrack> track) const {
+  auto rtc_track = track->rtc_track();
+
+  if (rtc_track->kind() == webrtc::MediaStreamTrackInterface::kAudioKind) {
+    auto* audio_track =
+        static_cast<webrtc::AudioTrackInterface*>(rtc_track.get());
+    return rtc_runtime_->get_or_create_media_stream_track(
+        peer_factory_->CreateAudioTrack(label.c_str(),
+                                        audio_track->GetSource()));
+  }
+
+  if (rtc_track->kind() == webrtc::MediaStreamTrackInterface::kVideoKind) {
+    auto* video_track =
+        static_cast<webrtc::VideoTrackInterface*>(rtc_track.get());
+    return rtc_runtime_->get_or_create_media_stream_track(
+        peer_factory_->CreateVideoTrack(
+            webrtc::scoped_refptr<webrtc::VideoTrackSourceInterface>(
+                video_track->GetSource()),
+            label.c_str()));
+  }
+
+  throw std::runtime_error("cannot clone an unknown media track kind");
+}

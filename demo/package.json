{
  "name": "ackerdb-demo",
  "private": true,
  "type": "module",
  "workspaces": [
    "app/*",
    "packages/*"
  ],
  "scripts": {
    "admin:dev": "bun run --cwd app/admin-panel dev",
    "admin:build": "bun run --cwd app/admin-panel build",
    "mobile:dev": "bun run --cwd app/mobile start",
    "mobile:typecheck": "bun run --cwd app/mobile typecheck",
    "server:dev": "bun run --cwd app/server dev",
    "server:start": "bun run --cwd app/server start",
    "codegen": "acker codegen app/server",
    "design:dev": "bun run --cwd app/design dev",
    "seed": "bun scripts/seed.ts",
    "smoke": "bun scripts/smoke.ts",
    "typecheck": "bun run codegen && tsc -p scripts/tsconfig.json && bun run --cwd app/server typecheck && bun run --cwd packages/ackerdb-codegen typecheck && bun run --cwd app/admin-panel typecheck && bun run --cwd app/mobile typecheck && bun run --cwd app/design typecheck"
  },
  "dependencies": {
    "@ackerdb/cli": "0.10.0",
    "@ackerdb/client": "0.10.0",
    "@ackerdb/client-react": "0.10.0",
    "@ackerdb/core": "0.10.0",
    "@ackerdb/server": "0.10.0"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "typescript": "^5.9.0"
  }
}

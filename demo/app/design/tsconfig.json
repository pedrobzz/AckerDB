{
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "types": ["react", "react-dom"],
    "paths": {
      "@theme": ["./src/theme.ts"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"]
}
